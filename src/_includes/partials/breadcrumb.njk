{#- crumbs: [{ name, url }]. The last item is the current page (not a link). A link trail, not an eyebrow. -#}
<nav class="crumbs wrap" aria-label="Breadcrumb">
  <ol role="list">
    {%- for c in crumbs %}
    <li>{% if loop.last %}<span aria-current="page">{{ c.name }}</span>{% else %}<a href="{{ c.url }}">{{ c.name }}</a>{% endif %}</li>
    {%- endfor %}
  </ol>
</nav>
