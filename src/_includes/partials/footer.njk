<footer class="foot">
  <div class="wrap">
    <div class="foot__row">
      <p class="cap">{{ site.description }}</p>
      <p class="cap">{{ site.affiliation }}</p>
    </div>
    <div class="foot__row foot__small">
      <span class="cap">&copy; {{ year }} {{ site.name }}</span>
      <span class="foot__links">
        <a class="cap" href="mailto:{{ site.email }}">{{ site.email }}</a>
        <a class="cap" href="{{ site.sameAs[0] }}" rel="noopener">Instagram</a>
        <a class="cap" href="/privacy">Privacy</a>
      </span>
    </div>
  </div>
</footer>
